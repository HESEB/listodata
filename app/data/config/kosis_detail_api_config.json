{
  "updated_at": "2026-09-16",
  "policy": "phase10_5_kosis_detail_api_v2",
  "secret_name": "KOSIS_API_KEY",
  "metadata_endpoint": "https://kosis.kr/openapi/statisticsData.do",
  "parameter_endpoint": "https://kosis.kr/openapi/Param/statisticsParameterData.do",
  "metadata_query": {
    "method": "getMeta",
    "type": "ITM",
    "format": "json",
    "content": "json"
  },
  "probe_query": {
    "method": "getList",
    "format": "json",
    "jsonVD": "Y",
    "newEstPrdCnt": "1"
  },
  "candidate_limit_per_run": 20,
  "max_probe_pairs_per_metric": 6,
  "request_timeout_seconds": 15,
  "max_response_bytes": 4000000,
  "minimum_metric_keyword_score": 1,
  "metadata_aliases": {
    "object_id": ["OBJ_ID", "objId", "obj_id"],
    "object_name": ["OBJ_NM", "objNm", "obj_nm"],
    "item_id": ["ITM_ID", "itmId", "itm_id"],
    "item_name": ["ITM_NM", "itmNm", "itm_nm"],
    "parent_item_id": ["UP_ITM_ID", "upItmId", "up_itm_id"],
    "object_sequence": ["OBJ_ID_SN", "objIdSn", "obj_id_sn"],
    "unit": ["UNIT_NM", "unitNm", "unit", "UNIT"]
  },
  "response_aliases": {
    "item_id": ["ITM_ID", "itmId", "itm_id"],
    "classification_value": ["C1", "C1_ID", "objL1"],
    "classification_name": ["C1_NM", "C1_OBJ_NM", "c1Nm"],
    "unit": ["UNIT_NM", "unitNm", "unit", "UNIT"]
  },
  "security": {
    "never_write_api_key": true,
    "mask_query_in_status": true,
    "fail_soft_without_secret": true,
    "manual_approval_required": true,
    "auto_apply_to_mapping_template": false
  },
  "notice": "분류·항목 후보는 KOSIS 통계표 메타(type=ITM)에서 찾고, ITM_ID·분류값 조합은 통계표선택 API로 실제 응답을 시험해 complete 근거만 승인 후보로 제공합니다."
}
